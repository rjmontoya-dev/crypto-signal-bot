# Telegram Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# CryptoPanic API (optional - for news filtering)
CRYPTOPANIC_API_TOKEN=your_cryptopanic_api_token

# Exchange Configuration
EXCHANGE=binance

# Trading Pairs (comma-separated)
# Use futures symbols for funding rate data: BTCUSDT, ETHUSDT (no slash for futures)
# Use spot symbols for non-futures: BTC/USDT (with slash)
TOKENS=BTC/USDT,ETH/USDT,SOL/USDT,ADA/USDT

# Analysis Timeframe
TIMEFRAME=4h

# Safety Mode
PAPER_TRADING=true

# Max Open Trades (enforce trade limit)
MAX_OPEN_TRADES=1
